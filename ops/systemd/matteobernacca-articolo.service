[Unit]
Description=matteobernacca: articolo della settimana
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/personal/matteobernacca
# GH_TOKEN per il push e UNSPLASH_ACCESS_KEY per la copertina (erin secret set matteobernacca ...).
EnvironmentFile=%h/.secrets/matteobernacca.env
Environment=HOME=%h
ExecStart=%h/personal/matteobernacca/ops/articolo-settimanale.sh
TimeoutStartSec=1h
Nice=10
