---
// Foto grande di Matteo nella home. Per cambiarla sostituisci src/assets/matteo.jpg
// (verticale o quadrata: nella home è ritagliata quadrata): Astro la ridimensiona e la converte in WebP in fase di build.
import { Image } from 'astro:assets';
import { site } from '../site';
import matteo from '../assets/matteo.jpg';

interface Props {
  badge?: boolean;
}
const { badge = true } = Astro.props;
---

<figure class="photo" style="margin:0">
  <Image
    src={matteo}
    alt={`${site.name}, ${site.profession.toLowerCase()}, nel suo studio a ${site.contact.city}`}
    widths={[480, 720, 960, 1200]}
    sizes="(max-width: 860px) 100vw, 40vw"
    loading="eager"
    fetchpriority="high"
    style="object-position: 50% 50%"
  />
  {badge && (
    <figcaption class="badge">
      <strong>{site.name}</strong>
      {site.profession} · {site.contact.city}
    </figcaption>
  )}
</figure>
