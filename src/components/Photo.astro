---
// Foto grande di Matteo (per ora un segnaposto).
// Per usare la foto vera: metti il file in public/matteo.jpg e sostituisci
// il blocco <svg> con <img src={href('/matteo.jpg')} alt="Matteo Bernacca, osteopata" />
// (importa `href` da '../site').
import { site } from '../site';

interface Props {
  badge?: boolean;
}
const { badge = true } = Astro.props;
---

<figure class="photo" role="img" aria-label="Foto di Matteo Bernacca, osteopata (segnaposto)" style="margin:0">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="8" r="4" />
    <path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" />
  </svg>
  {badge && (
    <figcaption class="badge">
      <strong>{site.name}</strong>
      {site.profession} · {site.contact.city}
    </figcaption>
  )}
</figure>
