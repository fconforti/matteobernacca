---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { href } from '../site';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: CollectionEntry<'articoli'>[];
  /** horizontal (default): immagine a destra, 2 per riga; vertical: immagine sopra, 4 per riga. */
  layout?: 'vertical' | 'horizontal';
}
const { posts, layout = 'horizontal' } = Astro.props;
const horizontal = layout === 'horizontal';
const sizes = horizontal
  ? '(max-width: 640px) 40vw, 20rem'
  : '(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 25vw';
---

<ul class:list={['cards', { 'cards-h': horizontal }]}>
  {posts.map((post) => (
    <li class="card">
      <a href={href(`/articoli/${post.id}/`)}>
        <div class="card-body">
          <div class="meta">
            <FormattedDate date={post.data.pubDate} />
          </div>
          <h3 class="title">{post.data.title}</h3>
          <p class="desc">{post.data.description}</p>
          <span class="more">Leggi articolo →</span>
        </div>
        {post.data.cover && (
          <Image class="cover" src={post.data.cover.image} alt="" widths={[400, 640]} sizes={sizes} />
        )}
      </a>
    </li>
  ))}
</ul>
