---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { href } from '../site';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: CollectionEntry<'articoli'>[];
  columns?: 2 | 4;
}
const { posts, columns = 4 } = Astro.props;
---

<ul class:list={['cards', { 'cards-2': columns === 2 }]}>
  {posts.map((post) => (
    <li class="card">
      <a href={href(`/articoli/${post.id}/`)}>
        {post.data.cover && (
          <Image class="cover" src={post.data.cover.image} alt="" widths={[400, 640]} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 25vw" />
        )}
        <div class="meta">
          <FormattedDate date={post.data.pubDate} />
        </div>
        <h3 class="title">{post.data.title}</h3>
        <p class="desc">{post.data.description}</p>
        <span class="more">Leggi articolo →</span>
      </a>
    </li>
  ))}
</ul>
