---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostList from '../../components/PostList.astro';
import { site, href, unsplashRef } from '../../site';
import { breadcrumbs, faqFromMarkdown, ids } from '../../schema';

export async function getStaticPaths() {
  const posts = await getCollection('articoli', ({ data }) => !data.draft);
  const byDate = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post) => {
    // Correlati: quelli indicati in `related`, poi quelli con più tag in comune, poi i più recenti.
    const shared = (o: typeof post) => o.data.tags.filter((t) => post.data.tags.includes(t)).length;
    const picked = post.data.related
      .map((id) => posts.find((o) => o.id === id))
      .filter((o): o is typeof post => Boolean(o));
    const related = [...picked, ...byDate
      .filter((o) => o.id !== post.id && !picked.includes(o))
      .map((o, i) => ({ o, score: shared(o), i }))
      .sort((a, b) => b.score - a.score || a.i - b.i)
      .map(({ o }) => o)].slice(0, 4);
    return { params: { slug: post.id }, props: { post, related } };
  });
}

interface Props {
  post: CollectionEntry<'articoli'>;
  related: CollectionEntry<'articoli'>[];
}
const { post, related } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, cover } = post.data;

// Copertina in JPEG 1200px per anteprime social e dati strutturati.
const share = cover ? await getImage({ src: cover.image, width: 1200, format: 'jpg' }) : undefined;
const ogImage = share && cover
  ? { url: new URL(share.src, Astro.site).toString(), width: Number(share.attributes.width), height: Number(share.attributes.height), alt: cover.alt }
  : undefined;

const url = new URL(Astro.url.pathname, Astro.site).toString();
const id = ids(Astro.site!);
const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#articolo`,
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    inLanguage: site.lang,
    mainEntityOfPage: url,
    articleSection: post.data.category,
    keywords: post.data.tags.join(', '),
    ...(ogImage ? { image: ogImage.url } : {}),
    about: { '@type': 'Thing', name: 'Osteopatia' },
    author: { '@id': id.person },
    publisher: { '@id': id.person },
    isPartOf: { '@id': id.website },
    encoding: {
      '@type': 'MediaObject',
      encodingFormat: 'text/markdown',
      contentUrl: new URL(href(`/articoli/${post.id}.md`), Astro.site).toString(),
    },
  },
  breadcrumbs(Astro.site!, [
    { name: 'Home', path: '/' },
    { name: 'Articoli', path: '/articoli/' },
    { name: title, path: `/articoli/${post.id}/` },
  ]),
  ...(post.data.faq ? [faqFromMarkdown(post.body ?? '')] : []),
];
---

<Base title={title} description={description} type="article" publishedTime={pubDate} modifiedTime={updatedDate} ogImage={ogImage} jsonLd={jsonLd} markdownPath={`/articoli/${post.id}.md`} bodyClass="page-article">
  <div class="article-wrap">
  <a class="back" href={href('/articoli/')}>← Tutti gli articoli</a>
  <article class="article">
    <div class="article-top">
    <header>
      <span class="eyebrow">{post.data.category}</span>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="meta">
        <a href={href('/')}>{site.name}</a>
        <span class="dot">·</span>
        <FormattedDate date={pubDate} />
        {updatedDate && <><span class="dot">·</span><span>aggiornato il <FormattedDate date={updatedDate} /></span></>}
      </div>
    </header>
    {cover && (
      <figure class="cover">
        <Image src={cover.image} alt={cover.alt} widths={[640, 960, 1360]} sizes="(max-width: 760px) 100vw, 46rem" loading="eager" fetchpriority="high" />
        <figcaption>
          Foto di <a href={unsplashRef(cover.authorUrl)} rel="noopener">{cover.author}</a> su <a href={unsplashRef(cover.url)} rel="noopener">Unsplash</a>
        </figcaption>
      </figure>
    )}
    </div>
    <div class="article-body">
    <div class="content">
      <Content />
    </div>
    <p class="notice">
      Questo articolo ha uno scopo informativo e non sostituisce una visita medica. In caso di dolore
      forte, improvviso o accompagnato da altri sintomi, rivolgiti prima al tuo medico.
    </p>
    </div>
  </article>

  <section class="related" id="correlati">
    <h2>Potrebbero interessarti</h2>
    <PostList posts={related} />
  </section>
  </div>
</Base>
