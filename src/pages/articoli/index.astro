---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Cta from '../../components/Cta.astro';
import { site } from '../../site';

const posts = (await getCollection('articoli', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base
  title="Articoli: capire l'osteopatia"
  description={`Articoli semplici e con esempi per capire che cos'è l'osteopatia, quando può aiutare e come funziona un percorso con un osteopata in ${site.area}.`}
>
  <span class="eyebrow">Articoli</span>
  <h1>Capire l'osteopatia</h1>
  <p class="lead" style="max-width:44rem;margin-bottom:3rem">
    Articoli scritti con parole semplici, per chi non è del mestiere. Parto dalle basi e
    aggiungo esempi presi dalla vita di tutti i giorni.
  </p>
  <PostList posts={posts} />
  <Cta />
</Base>
