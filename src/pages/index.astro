---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import PostList from '../components/PostList.astro';
import Cta from '../components/Cta.astro';
import { site, href } from '../site';

const posts = (await getCollection('articoli', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 8);

const areas = [
  { label: 'Schiena e collo', title: 'Mal di schiena e cervicale', text: 'Lombalgia, colpo della strega, collo rigido, mal di testa che parte dalla nuca.', slug: 'mal-di-schiena-osteopatia' },
  { label: 'Postura e lavoro', title: 'Ore al computer o in piedi', text: 'Tensioni da scrivania e smart working, ore di guida, lavori fisici e stagionali.', slug: 'postura-e-lavoro-al-computer' },
  { label: 'Sport', title: 'Fastidi che tornano', text: 'Dolori che si ripresentano sempre nello stesso punto, recupero dopo sforzi e piccoli infortuni.', slug: 'osteopatia-e-sport' },
  { label: 'Gravidanza e dopo il parto', title: 'Schiena e bacino', text: 'Tecniche delicate per i dolori della gravidanza e per il recupero nei mesi dopo il parto.', slug: 'osteopatia-in-gravidanza' },
];
---

<Base>
  <section class="hero">
    <div>
      <span class="eyebrow">Osteopata a {site.contact.city} · {site.area}</span>
      <h1>Un osteopata in Versilia, per chi ci vive <em>e per chi è in vacanza</em></h1>
      <p class="lead">{`Sono Matteo Bernacca, osteopata. Ricevo a ${site.contact.city} e seguo persone di ${site.towns.slice(1, 4).join(', ')} e di tutta la Versilia, oltre a chi è qui in vacanza e cerca un percorso breve.`}</p>
      <div class="actions">
        <a class="btn" href={href('/prima-visita/')}>Prenota una visita gratuita</a>
        <a class="btn secondary" href={href('/articoli/')}>Leggi i miei articoli</a>
      </div>
    </div>
    <Photo />
  </section>

  <section class="section">
    <span class="eyebrow">Di cosa mi occupo</span>
    <h2 style="margin-top:0">Un approccio manuale, sul corpo nel suo insieme</h2>
    <p class="lead" style="max-width:44rem">
      Valuto e tratto con tecniche manuali, cercando di capire da dove nasce un problema e non solo
      dove fa male.
    </p>
    <div class="features" style="margin-top:2rem">
      {areas.map((area) => (
        <div class="feature">
          <span class="eyebrow">{area.label}</span>
          <h3>{area.title}</h3>
          <p>{area.text}</p>
          <a class="more" href={href(`/articoli/${area.slug}/`)}>Scopri di più →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Articoli</span>
        <h2>Capire l'osteopatia</h2>
      </div>
      <a href={href('/articoli/')}>Tutti gli articoli →</a>
    </div>
    <PostList posts={posts} />
  </section>

  <section class="section band">
    <span class="eyebrow">In vacanza in Versilia?</span>
    <h2>Un percorso breve, mentre sei qui</h2>
    <p style="max-width:44rem">
      Se sei in vacanza a Forte dei Marmi, Marina di Pietrasanta o Lido di Camaiore e hai un dolore
      che dura da mesi, possiamo organizzare due o tre sedute ravvicinate e un piano da seguire quando torni a casa.
    </p>
    <a class="btn secondary" href={href('/articoli/osteopata-in-vacanza-in-versilia/')}>Come funziona</a>
  </section>

  <Cta />
</Base>
