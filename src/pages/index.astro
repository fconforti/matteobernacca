---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import PostList from '../components/PostList.astro';
import ContactButton from '../components/ContactButton.astro';
import Reviews from '../components/Reviews.astro';
import { site, href } from '../site';
import { ids } from '../schema';

const posts = (await getCollection('articoli', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 8);

const areas = [
  { label: 'Schiena e collo', title: 'Mal di schiena e cervicale', text: 'Lombalgia, colpo della strega, collo rigido, mal di testa che parte dalla nuca.', slug: 'mal-di-schiena-osteopatia' },
  { label: 'Postura e lavoro', title: 'Ore al computer o in piedi', text: 'Tensioni da scrivania e smart working, ore di guida, lavori fisici e stagionali.', slug: 'postura-e-lavoro-al-computer' },
  { label: 'Sport', title: 'Fastidi che tornano', text: 'Dolori che si ripresentano sempre nello stesso punto, recupero dopo sforzi e piccoli infortuni.', slug: 'osteopatia-e-sport' },
  { label: 'Gravidanza e dopo il parto', title: 'Schiena e bacino', text: 'Tecniche delicate per i dolori della gravidanza e per il recupero nei mesi dopo il parto.', slug: 'osteopatia-in-gravidanza' },
];

const steps = [
  { title: 'Parliamo', text: "Mi racconti il problema, da quanto tempo c'è, cosa lo peggiora e cosa hai già provato." },
  { title: 'Valutazione', text: 'Osservo come stai in piedi e come ti muovi, e verifico dove il movimento è libero e dove no.' },
  { title: 'Trattamento', text: 'Uso tecniche manuali delicate e ti spiego cosa sto facendo. Se qualcosa ti dà fastidio, cambio tecnica.' },
  { title: 'Piano', text: 'Ti dico cosa ho trovato, cosa possiamo fare e quante sedute servono indicativamente.' },
];

const jsonLd = [{ '@type': 'ProfilePage', mainEntity: { '@id': ids(Astro.site!).person } }];
---

<Base jsonLd={jsonLd}>
  <section class="hero">
    <div>
      <span class="eyebrow">Osteopata a {site.contact.city} · {site.area}</span>
      <h1>Un osteopata in Versilia, per chi ci vive <em>e per chi è in vacanza</em></h1>
      <p class="lead">Sono Matteo Bertacca, osteopata. Ricevo a {site.contact.city} e seguo persone di tutta la {site.area}.</p>
      <div class="actions">
        <ContactButton />
        <a class="btn secondary" href={href('/articoli/')}>Leggi i miei articoli</a>
      </div>
    </div>
    <Photo />
  </section>

  <section class="section section-white" id="chi-sono">
    <div class="split about">
      <div>
        <span class="eyebrow">Chi sono</span>
        <h2>Da oltre dieci anni lavoro con il corpo e con il movimento</h2>
        <p class="lead">
          Lavoro con un approccio manuale e dedico a ogni persona il tempo necessario per capire il suo problema.
        </p>
      </div>
      <div>
      <p>
        In studio la prima cosa che faccio è ascoltare: che cosa senti, da quanto tempo, che cosa lo peggiora e che
        cosa lo migliora. Solo dopo passo alla valutazione e al trattamento manuale, perché spesso il punto da cui nasce
        un problema non è quello che fa male.
      </p>
      <p>
        Seguo persone di ogni età: chi lavora tante ore al computer, chi fa sport, chi ha un mestiere fisico, chi
        ha superato i settanta e vuole continuare a muoversi bene. E sempre più persone in vacanza in Versilia, che
        approfittano del tempo libero per occuparsi di un dolore che si trascinano da mesi: per loro organizzo percorsi
        brevi e concentrati.
      </p>
      <p>
        Prima di diventare osteopata ho lavorato per anni come personal trainer e preparatore atletico, in palestra
        e con squadre di tennis e di calcio in Versilia. Per questo conosco da vicino i problemi di chi fa sport e di
        chi vuole tornare ad allenarsi dopo un dolore.
      </p>
      </div>
    </div>
  </section>

  <section class="section">
    <span class="eyebrow">Di cosa mi occupo</span>
    <h2>Un approccio manuale, sul corpo nel suo insieme</h2>
    <p class="lead">
      Valuto e tratto con tecniche manuali, cercando di capire da dove nasce un problema e non solo
      dove fa male.
    </p>
    <div class="features features-white">
      {areas.map((area) => (
        <div class="feature">
          <span class="eyebrow">{area.label}</span>
          <h3>{area.title}</h3>
          <p>{area.text}</p>
          <a class="more" href={href(`/articoli/${area.slug}/`)}>Scopri di più →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="section section-white" id="prima-visita">
    <span class="eyebrow">Prima visita</span>
    <h2>Una prima visita gratuita</h2>
    <p class="lead">
      La prima visita è gratuita e senza impegno. Mi racconti il problema, faccio una valutazione e alla fine
      ti dico cosa ho trovato e se, secondo me, l'osteopatia può aiutarti. Se decidi di non proseguire, va bene così.
    </p>
    <p class="muted">Dura circa un'ora. Vieni con abiti comodi e, se li hai, porta gli esami o i referti che riguardano il problema.</p>
    <div class="features">
      {steps.map((step, i) => (
        <div class="feature">
          <span class="step-num">{i + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      ))}
    </div>
    <div class="actions">
      <ContactButton />
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Articoli</span>
        <h2>Capire l'osteopatia</h2>
      </div>
      <a href={href('/articoli/')}>Tutti gli articoli →</a>
    </div>
    <PostList posts={posts} />
  </section>

  <Reviews />
</Base>
