---
import Base from '../layouts/Base.astro';
import { site, href, whatsappUrl } from '../site';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { breadcrumbs } from '../schema';

const jsonLd = [breadcrumbs(Astro.site!, [{ name: 'Home', path: '/' }, { name: 'Prima visita', path: '/prima-visita/' }])];
---

<Base
  title="Prenota una visita gratuita"
  description={`Prenota una prima visita osteopatica gratuita a ${site.contact.city}, in ${site.area}: WhatsApp, telefono, indirizzo dello studio e come si svolge il primo incontro.`}
  jsonLd={jsonLd}
>
  <section class="section">
    <span class="eyebrow">Contatti</span>
    <h1>Prenota una visita gratuita</h1>
    <p class="lead" style="max-width:40rem">Il modo più semplice è un messaggio WhatsApp: dimmi in due righe cosa senti e da quanto, e ti rispondo con una proposta di orario.</p>
    <div class="actions" style="margin-top:0">
      <a class="btn" href={whatsappUrl} target="_blank" rel="noopener"><WhatsAppIcon />Scrivimi su WhatsApp</a>
    </div>
    <div class="contact-grid">
      <div class="contact-item">
        <span class="label">Telefono</span>
        <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phoneDisplay}</a>
      </div>
      <div class="contact-item">
        <span class="label">Email</span>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </div>
      <div class="contact-item">
        <span class="label">Studio</span>
        <span class="value">{site.contact.address}, {site.contact.city} ({site.contact.province})</span>
      </div>
    </div>
    <p class="muted">
      <strong>Orari:</strong> {site.hours}<br />
      Comodo da {site.towns.filter((t) => t !== site.contact.city).join(', ')} e da tutta la Versilia.
    </p>
  </section>

  <section class="section band">
    <span class="eyebrow">Cosa aspettarsi</span>
    <h2>Come funziona</h2>
    <ol class="steps">
      <li><strong>Parliamo.</strong> Mi racconti il problema, da quanto tempo c'è e che cosa hai già provato. Se hai esami o referti, portali.</li>
      <li><strong>Ti osservo e ti valuto.</strong> Guardo come stai in piedi, come ti muovi, dove il movimento è libero e dove no.</li>
      <li><strong>Trattamento.</strong> Lavoro con le mani: tecniche delicate, mai dolorose, spiegate passo per passo.</li>
      <li><strong>Piano.</strong> Alla fine ti dico cosa ho trovato, cosa possiamo fare e quante sedute, indicativamente, servono.</li>
    </ol>
    <p class="muted small" style="margin:1.5rem 0 0">La prima visita è gratuita e dura circa un'ora. Vieni con abiti comodi.</p>
  </section>
</Base>
