---
import { site, href } from '../site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  type = 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
const isActive = (path: string) =>
  path === '/' ? current === href('/') + '/' || current === href('/') : current.startsWith(href(path));

const navItems = [
  { path: '/', match: '/', label: 'Home', icon: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V20h5v-6h4v6h5V9.5"/>' },
  { path: '/articoli/', match: '/articoli', label: 'Articoli', icon: '<path d="M4 4.5h11a3 3 0 0 1 3 3V20H7a3 3 0 0 1-3-3z"/><path d="M8 9h6M8 13h6M8 17h3"/>' },
  { path: '/chi-sono/', match: '/chi-sono', label: 'Chi sono', icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>' },
];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.profession,
  url: new URL(href('/'), Astro.site).toString(),
  email: site.contact.email,
  telephone: site.contact.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.contact.address,
    addressLocality: site.contact.city,
    addressRegion: site.contact.province,
    postalCode: site.contact.postalCode,
    addressCountry: 'IT',
  },
};
const ld = jsonLd ?? personLd;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={href('/rss.xml')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={site.locale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="geo.region" content="IT-LU" />
    <meta name="geo.placename" content={`${site.area}, ${site.region}`} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <header class="header">
      <div class="wrap">
        <a class="brand" href={href('/')}>
          <strong>{site.name}</strong>
          <span>{site.profession} in {site.area}</span>
        </a>
        <div class="header-right">
          <nav class="nav" aria-label="Principale">
            {navItems.map((item) => (
              <a href={href(item.path)} aria-current={isActive(item.match) ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
                <span>{item.label}</span>
              </a>
            ))}
          </nav>
          <a class="nav-cta" href={href('/chi-sono/#contatti')}>Prenota</a>
        </div>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="wrap">
        <div>
          <strong>{site.name}</strong>
          {site.profession} · {site.contact.city} ({site.contact.province}), {site.area}
        </div>
        <nav aria-label="Footer">
          <a href={href('/articoli/')}>Articoli</a>
          <a href={href('/chi-sono/')}>Chi sono</a>
          <a href={href('/chi-sono/#contatti')}>Contatti</a>
          <a href={href('/rss.xml')}>RSS</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
