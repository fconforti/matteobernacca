---
import { site, href, whatsappUrl } from '../site';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import Cta from '../components/Cta.astro';
import { getImage } from 'astro:assets';
import { baseGraph } from '../schema';
import matteo from '../assets/matteo.jpg';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Nodi JSON-LD specifici della pagina, aggiunti a WebSite, Person e LocalBusiness. */
  jsonLd?: Record<string, unknown>[];
  /** Versione Markdown della pagina, per agent e LLM. */
  markdownPath?: string;
  bodyClass?: string;
  /** Immagine per anteprime social (di default la foto di Matteo). */
  ogImage?: { url: string; width: number; height: number; alt: string };
}

const {
  title,
  description = site.description,
  type = 'website',
  publishedTime,
  modifiedTime,
  jsonLd = [],
  markdownPath,
  bodyClass,
  ogImage,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
const isActive = (path: string) =>
  path === '/' ? current === href('/') + '/' || current === href('/') : current.startsWith(href(path));

const navItems = [
  { path: '/', match: '/', label: 'Chi sono', icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>' },
  { path: '/articoli/', match: '/articoli', label: 'Articoli', icon: '<path d="M4 4.5h11a3 3 0 0 1 3 3V20H7a3 3 0 0 1-3-3z"/><path d="M8 9h6M8 13h6M8 17h3"/>' },
];

// Foto di Matteo in JPEG 1200px: anteprima nei social e immagine nei dati strutturati.
const shareImage = await getImage({ src: matteo, width: 1200, format: 'jpg' });
const imageUrl = new URL(shareImage.src, Astro.site).toString();
const og = ogImage ?? {
  url: imageUrl,
  width: Number(shareImage.attributes.width),
  height: Number(shareImage.attributes.height),
  alt: `${site.name}, ${site.profession.toLowerCase()}`,
};

const ld = { '@context': 'https://schema.org', '@graph': [...baseGraph(Astro.site!, imageUrl), ...jsonLd] };
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={href('/rss.xml')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <!-- Per agent e LLM: indice del sito e testo completo in Markdown -->
    <link rel="alternate" type="text/plain" title="llms.txt" href={href('/llms.txt')} />
    <link rel="alternate" type="text/plain" title="llms-full.txt" href={href('/llms-full.txt')} />
    {markdownPath && <link rel="alternate" type="text/markdown" title="Versione Markdown" href={href(markdownPath)} />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={og.url} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:image" content={og.url} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="geo.region" content="IT-LU" />
    <meta name="geo.placename" content={`${site.area}, ${site.region}`} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body class={bodyClass}>
    <header class="header">
      <div class="wrap">
        <a class="brand" href={href('/')}>
          <strong>{site.name}</strong>
          <span>{site.profession} in {site.area}</span>
        </a>
        <div class="header-right">
          <nav class="nav" aria-label="Principale">
            {navItems.map((item) => (
              <a href={href(item.path)} aria-current={isActive(item.match) ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
                <span>{item.label}</span>
              </a>
            ))}
            <a class="nav-contact" href={whatsappUrl} target="_blank" rel="noopener">
              <WhatsAppIcon class="nav-icon wa-icon" />
              <span>Contattami</span>
            </a>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
        <Cta />
      </div>
    </main>

    <footer class="footer">
      <div class="wrap">
        <div>
          <strong>{site.name}</strong>
          {site.profession} · {site.contact.city} ({site.contact.province}), {site.area}
        </div>
        <nav aria-label="Footer">
          <a href={href('/articoli/')}>Articoli</a>
          <a href={href('/')}>Chi sono</a>
          <a href={href('/#contatti')}>Contatti</a>
          <a href={href('/rss.xml')}>RSS</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
